{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autocarto.local/schemas/task-knowledge-graph-v1.json",
  "title": "AutoCarto 行军路线制图任务知识图谱",
  "type": "object",
  "required": [
    "schema_version",
    "task",
    "spatial_entities",
    "routes",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task": {
      "type": "object",
      "required": ["task_id", "title", "map_type", "input_crs"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "map_type": {"const": "marching_route"},
        "input_crs": {"type": "string", "const": "EPSG:4326"}
      },
      "additionalProperties": false
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor_id", "name", "confidence", "evidence_refs"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "aliases": {
            "type": "array",
            "items": {"type": "string"}
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "spatial_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "entity_kind",
          "name",
          "factual",
          "map_role",
          "evidence_refs"
        ],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "entity_kind": {
            "enum": ["place", "region", "cartographic_control"]
          },
          "name": {"type": "string", "minLength": 1},
          "map_role": {
            "enum": ["route_node", "event_anchor", "background", "control"]
          },
          "coordinate_source": {
            "enum": [
              "source_text",
              "llm_estimated",
              "manual",
              "gazetteer",
              "derived_control"
            ]
          },
          "lon": {"type": "number", "minimum": -180, "maximum": 180, "description": "经纬度成对提供；待定位时省略坐标及坐标来源、置信度，不填 0 或 null。"},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "coordinate_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "geocoding": {
            "type": "object",
            "description": "程序定位的查询、候选与状态记录；由坐标补全服务填写，不由知识抽取模型生成。",
            "additionalProperties": true
          },
          "factual": {"type": "boolean"},
          "description": {"type": "string"},
          "generation_reason": {"type": "string"},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "name",
          "event_type",
          "location_ref",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "event_type": {
            "enum": [
              "departure",
              "arrival",
              "passage",
              "battle",
              "meeting",
              "rendezvous",
              "base",
              "turn",
              "other"
            ]
          },
          "location_ref": {"type": "string", "minLength": 1},
          "actor_refs": {
            "type": "array",
            "items": {"type": "string"}
          },
          "time_text": {"type": "string"},
          "description": {"type": "string"},
          "priority": {"type": "number"},
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "route_id",
          "name",
          "topology",
          "side",
          "paths",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "route_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "topology": {"enum": ["standard", "branch", "multi_start"]},
          "side": {"enum": ["friendly", "enemy", "neutral"]},
          "enabled": {"type": "boolean"},
          "style_ref": {
            "enum": [
              "friendly_main_red",
              "enemy_main_blue",
              "friendly_branch_red",
              "enemy_branch_blue",
              "friendly_multi_start_red",
              "enemy_multi_start_blue"
            ]
          },
          "effective_width_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path_id", "role", "direction", "nodes"],
              "properties": {
                "path_id": {"type": "string", "minLength": 1},
                "actor_refs": {
                  "type": "array",
                  "description": "本路径的移动主体，引用 actors[].actor_id；旧图可缺省，不从事件或路线名称猜测。",
                  "items": {"type": "string", "minLength": 1}
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "role": {"enum": ["main", "branch", "incoming"]},
                "direction": {
                  "enum": [
                    "forward",
                    "away_from_attach",
                    "toward_attach"
                  ]
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["ref_type", "ref_id"],
                    "properties": {
                      "ref_type": {
                        "enum": ["spatial_entity", "event"]
                      },
                      "ref_id": {"type": "string", "minLength": 1}
                    },
                    "additionalProperties": false
                  }
                },
                "spatial_constraints": {
                  "type": "array",
                  "description": "原文中的方位约束，不是途经地名；程序在绘图副本生成隐藏控制点。",
                  "items": {
                    "type": "object",
                    "required": ["kind", "bearing"],
                    "properties": {
                      "kind": {"enum": ["approach_from", "via_relative"]},
                      "bearing": {"enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]},
                      "target_ref": {"type": "string", "minLength": 1},
                      "after_ref": {"type": "string", "minLength": 1},
                      "before_ref": {"type": "string", "minLength": 1},
                      "occurrence": {"type": "integer", "minimum": 1, "description": "via_relative 所引用的相邻地点对第几次出现，省略为第 1 次。"},
                      "relation": {"enum": ["within", "outside"]},
                      "reference": {
                        "type": "object",
                        "required": ["name"],
                        "properties": {
                          "name": {"type": "string", "minLength": 1},
                          "lon": {"type": "number", "minimum": -180, "maximum": 180},
                          "lat": {"type": "number", "minimum": -90, "maximum": 90},
                          "coordinate_source": {"enum": ["source_text", "llm_estimated", "manual", "gazetteer"]},
                          "coordinate_confidence": {"type": "number", "minimum": 0, "maximum": 1},
                          "geocoding": {"type": "object", "additionalProperties": true}
                        },
                        "additionalProperties": false
                      },
                      "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
                    },
                    "additionalProperties": false
                  }
                },
                "control_options": {
                  "type": "object",
                  "description": "程序或用户指定的制图长度（米），不代表历史行军距离。",
                  "properties": {
                    "display_length_m": {"type": "number", "exclusiveMinimum": 0},
                    "offset_m": {"type": "number", "exclusiveMinimum": 0}
                  },
                  "additionalProperties": false
                },
                "attach_ref": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "point_presentations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "presentation_id",
          "anchor_ref_type",
          "anchor_ref",
          "symbol_type",
          "priority",
          "visible"
        ],
        "properties": {
          "presentation_id": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "anchor_ref_type": {"enum": ["spatial_entity", "event"]},
          "anchor_ref": {"type": "string", "minLength": 1},
          "symbol_type": {
            "enum": [
              "start_flag",
              "battle",
              "meeting",
              "rendezvous"
            ]
          },
          "priority": {"type": "number"},
          "visible": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "callouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "callout_id",
          "anchor_ref_type",
          "anchor_ref",
          "title",
          "body"
        ],
        "properties": {
          "callout_id": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "anchor_ref_type": {"enum": ["spatial_entity", "event"]},
          "anchor_ref": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "body": {"type": "string"},
          "template": {
            "enum": [
              "text_only",
              "image_top_text_bottom",
              "image_left_text_right",
              "image_only_ellipse",
              "ellipse_badge"
            ]
          },
          "image_enabled": {"type": "boolean"},
          "image_path": {"type": "string"},
          "priority": {"type": "number"},
          "preferred_side": {"type": "string"},
          "width_mm": {"type": "number", "exclusiveMinimum": 0},
          "leader_style": {
            "enum": ["straight", "curved", "double"],
            "default": "double"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "quote"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "output_constraints": {
      "type": "object",
      "properties": {
        "self_intersection_policy": {
          "enum": ["allow", "allow_with_overpass", "avoid"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
