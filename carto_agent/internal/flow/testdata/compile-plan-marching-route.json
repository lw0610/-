      ],
      "expected_outputs": [
        {
          "label": "路线图层",
          "type": "layers",
          "required": true
        },
        {
          "label": "专题点图层",
          "type": "layers",
          "required": true
        }
      ],
      "on_failure": "ask",
      "missing_capabilities": [],
