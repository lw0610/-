  "evidence": [
    {
      "evidence_id": "ev01",
      "quote": "1934年11月16日，红二十五军从河南省罗山县何家冲出发，开始向西实行战略转移"
    },
    {
      "evidence_id": "ev02",
      "quote": "于11月26日到达河南省方城县独树镇七里岗"
    },
    {
      "evidence_id": "ev03",
      "quote": "红二十五军在独树镇同堵截部队发生激战"
    },
    {
      "evidence_id": "ev04",
      "quote": "突出重围后进入伏牛山区，继续向西穿越卢氏山区"
    },
    {
      "evidence_id": "ev05",
      "quote": "于12月8日攻破豫陕交界的铁锁关"
    },
    {
      "evidence_id": "ev06",
      "quote": "12月9日到达陕西雒南县庾家河"
    },
    {
      "evidence_id": "ev07",
      "quote": "12月10日，部队在庾家河一带作战，中共鄂豫皖省委同时召开会议，决定创建鄂豫陕革命根据地"
    },
    {
      "evidence_id": "ev08",
      "quote": "在鄂豫陕边区进行了持续数月的往返转战"
    },
    {
      "evidence_id": "ev09",
      "quote": "红二十五军从庾家河地区向南进入湖北郧西二天门一带"
    },
    {
      "evidence_id": "ev10",
      "quote": "随后北返陕西洛南、商县地区"
    },
    {
      "evidence_id": "ev11",
      "quote": "又向东进入河南卢氏"
    },
    {
      "evidence_id": "ev12",
      "quote": "之后转向西部的蓝田和葛牌镇方向"
    },
    {
      "evidence_id": "ev13",
      "quote": "1935年初，红二十五军围绕鄂豫陕根据地进行了多次反\"围剿\"行动"
    },
    {
      "evidence_id": "ev14",
      "quote": "先后在蔡玉窑、葛牌镇附近的文公岭等地作战"
    },
    {
      "evidence_id": "ev15",
      "quote": "并在柞水、宁陕、佛坪和华阳之间往返机动"
    },
    {
      "evidence_id": "ev16",
      "quote": "这些地点属于根据地时期的不同作战区域，不是一条从蔡玉窑依次经过葛牌镇、柞水、宁陕、佛坪再到华阳的连续行军路线"
    },
    {
      "evidence_id": "ev17",
      "quote": "1935年6月，红二十五军从郧西二天门地区再次北上"
    },
    {
      "evidence_id": "ev18",
      "quote": "随后奔袭淅川荆紫关"
    },
    {
      "evidence_id": "ev19",
      "quote": "完成荆紫关行动后，部队转向陕西山阳袁家沟口地区"
    },
    {
      "evidence_id": "ev20",
      "quote": "7月2日，红二十五军在袁家沟口取得重要战斗胜利"
    },
    {
      "evidence_id": "ev21",
      "quote": "随后北出终南山，逼近西安南部，最终到达沣峪口"
    },
    {
      "evidence_id": "ev22",
      "quote": "1935年7月15日，中共鄂豫陕省委在沣峪口召开会议，决定红二十五军继续西征北上"
    },
    {
      "evidence_id": "ev23",
      "quote": "7月16日，部队从沣峪口出发，沿秦岭地区向西行进"
    },
    {
      "evidence_id": "ev24",
      "quote": "途中折向秦岭南侧，到达留坝江口一带"
    },
    {
      "evidence_id": "ev25",
      "quote": "于7月底到达凤县双石铺"
    },
    {
      "evidence_id": "ev26",
      "quote": "首先到达两当，随后继续向天水推进"
    },
    {
      "evidence_id": "ev27",
      "quote": "部队在天水北关一带作战后转向北部，经秦安到达静宁"
    },
    {
      "evidence_id": "ev28",
      "quote": "再由静宁进入隆德"
    },
    {
      "evidence_id": "ev29",
      "quote": "8月21日，红二十五军在泾川县四坡村同国民党军发生激战"
    },
    {
      "evidence_id": "ev30",
      "quote": "经合水县板桥镇到达华池县豹子川"
    },
    {
      "evidence_id": "ev31",
      "quote": "随后进入保安永宁山一带"
    },
    {
      "evidence_id": "ev32",
      "quote": "9月15日，红二十五军到达陕西延川县永坪镇"
    },
    {
      "evidence_id": "ev33",
      "quote": "9月16日与陕甘红军会师，红二十五军长征至此结束"
    },
    {
      "evidence_id": "ev34",
      "quote": "永坪会师以后，红二十五军与红二十六军、红二十七军合编为红十五军团"
    },
    {
      "evidence_id": "ev35",
      "quote": "红十五军团随后又在劳山、榆林桥和直罗镇等地区作战"
    },
    {
      "evidence_id": "ev36",
      "quote": "各支国民党军的行动相互独立，并不是一条首尾相连的连续行军路线"
    },
    {
      "evidence_id": "ev37",
      "quote": "国民党第四十军第一一五旅等部队从南阳、方城方向进至独树镇七里岗一带实施堵截"
    },
    {
      "evidence_id": "ev38",
      "quote": "国民党第六十师在五里川、朱阳关方向封锁入陕通道，随后又从鸡头关方向追向庾家河"
    },
    {
      "evidence_id": "ev39",
      "quote": "东北军、西北军和陕西地方部队分别从西安、蓝田、商洛和汉中等方向向根据地推进"
    },
    {
      "evidence_id": "ev40",
      "quote": "一部分部队由西安方向向蓝田、葛牌镇和沣峪口方向进逼"
    },
    {
      "evidence_id": "ev41",
      "quote": "陕军警备第一旅由商洛、山阳方向向袁家沟口推进"
    },
    {
      "evidence_id": "ev42",
      "quote": "另有部队分别向柞水、宁陕和佛坪方向实施围攻"
    },
