      "callout_callout_excel_335ea18ea4ef764df8e8_body": {
        "item_id": "callout_callout_excel_335ea18ea4ef764df8e8_body",
        "rect_mm": {
          "height": 13.277272727272727,
          "width": 38.4,
          "x": 231.81371729999964,
          "y": 203.81012972732444
        },
        "text": "1935年3月4日，红二十五军由宁陕西进\n，经陈家坝、三郎沟一带攻克佛坪县城\n袁家庄。次日部队召开军民大会，宣传\n革命主张，开仓分粮救济贫苦群众，随\n后向洋县华阳继续前进。",
        "type": "QgsLayoutItemLabel",
        "z_value": 29.0
      },
