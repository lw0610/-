      "callout_callout_excel_371b352df4a3949a576f_body": {
        "item_id": "callout_callout_excel_371b352df4a3949a576f_body",
        "rect_mm": {
          "height": 15.875,
          "width": 38.4,
          "x": 452.0946449249992,
          "y": 207.63094370459737
        },
        "text": "1934年11月26日，红二十五军在方城县\n独树镇七里岗附近遭到敌军堵截。部队\n在风雪和饥寒中展开激战，吴焕先、徐\n海东等指挥反击，稳住阵地，随后乘夜\n突围，于27日进入伏牛山区，保存了主\n力。",
        "type": "QgsLayoutItemLabel",
        "z_value": 14.0
      },
