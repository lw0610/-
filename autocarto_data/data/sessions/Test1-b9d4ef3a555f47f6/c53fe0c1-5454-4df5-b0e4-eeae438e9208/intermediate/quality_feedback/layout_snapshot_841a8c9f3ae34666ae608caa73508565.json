      "callout_callout_excel_3c0497e5761ceb2fb590_body": {
        "item_id": "callout_callout_excel_3c0497e5761ceb2fb590_body",
        "rect_mm": {
          "height": 15.875,
          "width": 38.4,
          "x": 309.13885777499917,
          "y": 89.27019719626406
        },
        "text": "1935年9月15日，红二十五军到达永坪\n镇，16日与红二十六军、红二十七军会\n师。17日的联席会议决定将三军合编为\n红十五军团，由徐海东任军团长、程子\n华任政委、刘志丹任副军团长兼参谋长\n。",
        "type": "QgsLayoutItemLabel",
        "z_value": 83.0
      },
      "callout_callout_excel_3c0497e5761ceb2fb590_box": {
