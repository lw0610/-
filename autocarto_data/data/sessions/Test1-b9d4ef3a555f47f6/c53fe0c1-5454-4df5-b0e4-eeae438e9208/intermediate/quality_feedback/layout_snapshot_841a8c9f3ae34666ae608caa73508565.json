      "callout_callout_excel_76cf96da2ff24bf7b8f9_body": {
        "item_id": "callout_callout_excel_76cf96da2ff24bf7b8f9_body",
        "rect_mm": {
          "height": 15.875,
          "width": 38.4,
          "x": 497.49567367499895,
          "y": 272.10974517959727
        },
        "text": "1934年11月16日，红二十五军从河南罗\n山县何家冲出发，开始长征。部队以“中\n国工农红军北上抗日第二先遣队”为旗号\n，在程子华、吴焕先、徐海东等率领下\n西进，踏上由鄂豫皖向陕北转移的征程\n。",
        "type": "QgsLayoutItemLabel",
        "z_value": 5.0
      },
      "callout_callout_excel_76cf96da2ff24bf7b8f9_box": {
