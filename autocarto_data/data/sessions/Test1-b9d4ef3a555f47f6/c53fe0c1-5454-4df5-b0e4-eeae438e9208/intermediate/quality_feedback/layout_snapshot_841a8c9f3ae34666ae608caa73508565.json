      "callout_callout_excel_2ae82dd7685154d18b1c_body": {
        "item_id": "callout_callout_excel_2ae82dd7685154d18b1c_body",
        "rect_mm": {
          "height": 13.277272727272727,
          "width": 38.4,
          "x": 251.67243479999945,
          "y": 125.05723795459754
        },
        "text": "1935年10月1日，红十五军团在甘泉县劳\n山地区设伏，歼灭由延安南援的国民党\n东北军第一一〇师主力。这是红二十五\n军与陕甘红军会师、整编后取得的重要\n胜利，巩固了陕甘革命根据地。",
        "type": "QgsLayoutItemLabel",
        "z_value": 88.0
      },
      "callout_callout_excel_2ae82dd7685154d18b1c_box": {
        "item_id": "callout_callout_excel_2ae82dd7685154d18b1c_box",
