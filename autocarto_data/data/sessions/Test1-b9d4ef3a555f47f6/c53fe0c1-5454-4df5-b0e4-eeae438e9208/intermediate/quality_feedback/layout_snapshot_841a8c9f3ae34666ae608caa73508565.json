      "callout_callout_excel_692b2095090aec9100b0_body": {
        "item_id": "callout_callout_excel_692b2095090aec9100b0_body",
        "rect_mm": {
          "height": 13.277272727272727,
          "width": 38.4,
          "x": 306.41099999999966,
          "y": 250.7637501566555
        },
        "text": "1934年12月10日，鄂豫皖省委在丹凤庾\n家河“春茂永”药铺召开会议，研究创建\n鄂豫陕革命根据地。会议期间敌军来袭\n，红二十五军在七里荫岭激战，程子华\n、徐海东负伤，部队最终击退追兵。",
        "type": "QgsLayoutItemLabel",
        "z_value": 24.0
      },
      "callout_callout_excel_692b2095090aec9100b0_box": {
