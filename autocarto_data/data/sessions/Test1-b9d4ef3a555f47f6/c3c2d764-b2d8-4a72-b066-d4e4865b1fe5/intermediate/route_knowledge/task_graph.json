  "evidence": [
    {
      "evidence_id": "ev_01",
      "quote": "1934年11月16日，红二十五军从河南省罗山县何家冲出发，开始向西实行战略转移"
    },
    {
      "evidence_id": "ev_02",
      "quote": "于11月26日到达河南省方城县独树镇七里岗"
    },
    {
      "evidence_id": "ev_03",
      "quote": "红二十五军在独树镇同堵截部队发生激战，突出重围后进入伏牛山区"
    },
    {
      "evidence_id": "ev_04",
      "quote": "继续向西穿越卢氏山区，于12月8日攻破豫陕交界的铁锁关"
    },
    {
      "evidence_id": "ev_05",
      "quote": "12月9日到达陕西雒南县庾家河"
    },
    {
      "evidence_id": "ev_06",
      "quote": "12月10日，部队在庾家河一带作战，中共鄂豫皖省委同时召开会议，决定创建鄂豫陕革命根据地"
    },
    {
      "evidence_id": "ev_07",
      "quote": "第一次大范围转战中，红二十五军从庾家河地区向南进入湖北郧西二天门一带"
    },
    {
      "evidence_id": "ev_08",
      "quote": "随后北返陕西洛南、商县地区"
    },
    {
      "evidence_id": "ev_09",
      "quote": "又向东进入河南卢氏，之后转向西部的蓝田和葛牌镇方向"
    },
    {
      "evidence_id": "ev_10",
      "quote": "先后在蔡玉窑、葛牌镇附近的文公岭等地作战"
    },
    {
      "evidence_id": "ev_11",
      "quote": "并在柞水、宁陕、佛坪和华阳之间往返机动"
    },
    {
      "evidence_id": "ev_12",
      "quote": "这些地点属于根据地时期的不同作战区域，不是一条从蔡玉窑依次经过葛牌镇、柞水、宁陕、佛坪再到华阳的连续行军路线"
    },
    {
      "evidence_id": "ev_13",
      "quote": "1935年6月，红二十五军从郧西二天门地区再次北上，进入商县和商南方向"
    },
    {
      "evidence_id": "ev_14",
      "quote": "随后奔袭淅川荆紫关"
    },
    {
      "evidence_id": "ev_15",
      "quote": "完成荆紫关行动后，部队转向陕西山阳袁家沟口地区"
    },
    {
      "evidence_id": "ev_16",
      "quote": "7月2日，红二十五军在袁家沟口取得重要战斗胜利"
    },
    {
      "evidence_id": "ev_17",
      "quote": "随后北出终南山，逼近西安南部，最终到达沣峪口"
    },
    {
      "evidence_id": "ev_18",
      "quote": "1935年7月15日，中共鄂豫陕省委在沣峪口召开会议，决定红二十五军继续西征北上"
    },
    {
      "evidence_id": "ev_19",
      "quote": "7月16日，部队从沣峪口出发，沿秦岭地区向西行进，途中折向秦岭南侧，到达留坝江口一带"
    },
    {
      "evidence_id": "ev_20",
      "quote": "之后转向西北，于7月底到达凤县双石铺"
    },
    {
      "evidence_id": "ev_21",
      "quote": "红二十五军离开双石铺后进入甘肃，首先到达两当"
    },
    {
      "evidence_id": "ev_22",
      "quote": "随后继续向天水推进。部队在天水北关一带作战后转向北部"
    },
    {
      "evidence_id": "ev_23",
      "quote": "经秦安到达静宁，再由静宁进入隆德"
    },
    {
      "evidence_id": "ev_24",
      "quote": "8月21日，红二十五军在泾川县四坡村同国民党军发生激战"
    },
    {
      "evidence_id": "ev_25",
      "quote": "四坡村战斗后，部队继续向北，经合水县板桥镇到达华池县豹子川"
    },
    {
      "evidence_id": "ev_26",
      "quote": "随后进入保安永宁山一带，同陕甘革命根据地取得联系"
    },
    {
      "evidence_id": "ev_27",
      "quote": "9月15日，红二十五军到达陕西延川县永坪镇"
    },
    {
      "evidence_id": "ev_28",
      "quote": "9月16日与陕甘红军会师，红二十五军长征至此结束"
    },
    {
      "evidence_id": "ev_29",
      "quote": "永坪会师以后，红二十五军与红二十六军、红二十七军合编为红十五军团"
    },
    {
      "evidence_id": "ev_30",
      "quote": "红十五军团随后又在劳山、榆林桥和直罗镇等地区作战"
    },
    {
      "evidence_id": "ev_31",
      "quote": "劳山、榆林桥和直罗镇属于永坪会师以后的作战活动，不属于红二十五军从何家冲到永坪镇的长征主线"
    },
    {
      "evidence_id": "ev_32",
      "quote": "国民党第四十军第一一五旅等部队从南阳、方城方向进至独树镇七里岗一带实施堵截"
    },
    {
      "evidence_id": "ev_33",
