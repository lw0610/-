  "evidence": [
    {
      "evidence_id": "ev_01",
      "quote": "1934年11月，红二十五军开始实施战略转移"
    },
    {
      "evidence_id": "ev_02",
      "quote": "1934年11月16日，红二十五军从河南省罗山县何家冲出发"
    },
    {
      "evidence_id": "ev_03",
      "quote": "部队离开鄂豫皖革命根据地后，经罗古寨一带向西推进"
    },
    {
      "evidence_id": "ev_04",
      "quote": "当晚从东双河与柳林之间越过平汉铁路"
    },
    {
      "evidence_id": "ev_05",
      "quote": "部队经青石桥、黄龙寺、月河店、金桥等地进入桐柏山区"
    },
    {
      "evidence_id": "ev_06",
      "quote": "经泌阳一带北上，向方城方向挺进"
    },
    {
      "evidence_id": "ev_07",
      "quote": "11月26日，部队到达独树镇附近，在恶劣天气和敌军突然堵截的情况下展开独树镇战斗"
    },
    {
      "evidence_id": "ev_08",
      "quote": "该段路线的主要节点依次为何家冲、桐柏、泌阳和独树镇"
    },
    {
      "evidence_id": "ev_09",
      "quote": "红二十五军突破独树镇一带的堵截后，继续向西北方向行军，离开南阳盆地，进入伏牛山区"
    },
    {
      "evidence_id": "ev_10",
      "quote": "部队沿山区道路经过栾川，随后向卢氏方向前进"
    },
    {
      "evidence_id": "ev_11",
      "quote": "经过卢氏官坡、龙驹寨附近，冲破豫陕交界处的铁锁关"
    },
    {
      "evidence_id": "ev_12",
      "quote": "最终到达庾家河"
    },
    {
      "evidence_id": "ev_13",
      "quote": "该段路线的主要节点依次为独树镇、栾川、卢氏、铁锁关和庾家河"
    },
    {
      "evidence_id": "ev_14",
      "quote": "红二十五军到达庾家河后，在当地与追击而来的国民党军发生战斗"
    },
    {
      "evidence_id": "ev_15",
      "quote": "部队以商洛山区为主要活动区域，先后向山阳、柞水等地展开行动"
    },
    {
      "evidence_id": "ev_16",
      "quote": "红军在山阳袁家沟口等地打击敌军"
    },
    {
      "evidence_id": "ev_17",
      "quote": "红二十五军逐步由山阳、柞水一带向秦岭北部转移，最后在西安以南的沣峪口地区集结"
    },
    {
      "evidence_id": "ev_18",
      "quote": "该阶段的代表性路线节点为庾家河、山阳、柞水和沣峪口"
    },
    {
      "evidence_id": "ev_19",
      "quote": "1935年7月，中共鄂豫陕省委在沣峪口召开会议，决定率领红二十五军继续西进，以配合中央红军北上"
    },
    {
      "evidence_id": "ev_20",
