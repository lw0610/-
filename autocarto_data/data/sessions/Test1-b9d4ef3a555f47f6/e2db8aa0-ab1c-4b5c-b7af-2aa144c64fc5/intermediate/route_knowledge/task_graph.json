  "evidence": [
    {
      "evidence_id": "e01",
      "quote": "1934年11月，红二十五军开始实施战略转移。整个行军过程可以划分为七段相对独立、前后衔接的路线。"
    },
    {
      "evidence_id": "e02",
      "quote": "1934年11月16日，红二十五军从河南省罗山县何家冲出发。"
    },
    {
      "evidence_id": "e03",
      "quote": "部队离开鄂豫皖革命根据地后，经罗古寨一带向西推进，当晚从东双河与柳林之间越过平汉铁路。"
    },
    {
      "evidence_id": "e04",
      "quote": "随后，部队经青石桥、黄龙寺、月河店、金桥等地进入桐柏山区，并继续向桐柏、泌阳方向转移。"
    },
    {
      "evidence_id": "e05",
      "quote": "由于敌军在桐柏山区周围形成追堵态势，红二十五军绕过敌军重点设防地区，经泌阳一带北上，向方城方向挺进。"
    },
    {
      "evidence_id": "e06",
      "quote": "11月26日，部队到达独树镇附近，在恶劣天气和敌军突然堵截的情况下展开独树镇战斗。"
    },
    {
      "evidence_id": "e07",
      "quote": "该段路线的主要节点依次为何家冲、桐柏、泌阳和独树镇。"
    },
    {
      "evidence_id": "e08",
      "quote": "红二十五军突破独树镇一带的堵截后，继续向西北方向行军，离开南阳盆地，进入伏牛山区。"
    },
    {
      "evidence_id": "e09",
      "quote": "部队沿山区道路经过栾川，随后向卢氏方向前进。"
    },
    {
      "evidence_id": "e10",
      "quote": "到达卢氏地区后，敌军已在主要道路和山口设防，企图阻止红军进入陕西。"
    },
    {
      "evidence_id": "e11",
      "quote": "红二十五军采取声东击西的方式迷惑守敌，在当地群众带领下沿深山峡谷和水峪河一线绕开封锁，经过卢氏官坡、龙驹寨附近，冲破豫陕交界处的铁锁关。"
    },
    {
      "evidence_id": "e12",
      "quote": "越过铁锁关后，部队进入陕南商洛地区，继续向丹凤方向行军，最终到达庾家河。"
    },
    {
      "evidence_id": "e13",
      "quote": "该段路线的主要节点依次为独树镇、栾川、卢氏、铁锁关和庾家河。"
    },
    {
      "evidence_id": "e14",
      "quote": "这一段不是短时间内完成的单向行军，而是红二十五军在鄂豫陕地区建立根据地期间进行的区域转战。"
    },
    {
      "evidence_id": "e15",
      "quote": "红二十五军到达庾家河后，在当地与追击而来的国民党军发生战斗，并由此开始在陕南站稳脚跟。"
    },
    {
      "evidence_id": "e16",
      "quote": "此后，部队以商洛山区为主要活动区域，先后向山阳、柞水等地展开行动，在蓝田、商县、山阳、镇安和柞水交界地区辗转作战。"
    },
    {
      "evidence_id": "e17",
      "quote": "红军在山阳袁家沟口等地打击敌军，同时在柞水及周边山区发动群众、建立地方武装和基层政权。"
    },
    {
      "evidence_id": "e18",
      "quote": "随着形势变化，红二十五军逐步由山阳、柞水一带向秦岭北部转移，最后在西安以南的沣峪口地区集结。"
    },
    {
      "evidence_id": "e19",
      "quote": "该阶段的代表性路线节点为庾家河、山阳、柞水和沣峪口。"
    },
    {
      "evidence_id": "e20",
      "quote": "1935年7月，中共鄂豫陕省委在沣峪口召开会议，决定率领红二十五军继续西进，以配合中央红军北上。"
    },
    {
      "evidence_id": "e21",
      "quote": "部队从沣峪口出发后，沿秦岭北麓向西推进，经户县、周至一线进入秦岭山区，随后穿越山地向凤县方向行军。"
    },
    {
      "evidence_id": "e22",
      "quote": "经过连续行军，红二十五军到达凤县双石铺，并在当地进行短暂休整和作战准备。"
    },
    {
      "evidence_id": "e23",
      "quote": "此后部队由双石铺继续向西北前进，越过陕甘交界地区，进抵甘肃两当。"
    },
    {
      "evidence_id": "e24",
      "quote": "该段路线的主要节点为沣峪口、双石铺和两当，户县、周至和凤县一带为沿途经过的中间区域。"
    },
    {
      "evidence_id": "e25",
      "quote": "红二十五军进入两当后，继续向甘肃东南部推进。"
    },
    {
      "evidence_id": "e26",
      "quote": "部队从两当出发后兵分数路向天水方向行动，一度包围天水城区并攻入天水北关。"
    },
    {
      "evidence_id": "e27",
      "quote": "由于敌军增援部队逐渐逼近，红军主动撤出天水城区，经川口、天靖山和廖家岘一带向北转移。"
    },
    {
      "evidence_id": "e28",
      "quote": "在新阳镇群众帮助下，部队分批渡过渭河，随后经过甘谷渭水峪，到达秦安县千户镇，并继续向秦安县城方向推进。"
    },
    {
      "evidence_id": "e29",
      "quote": "离开秦安后，红二十五军向静宁方向行动，切断西兰公路沿线的交通联系。"
    },
    {
      "evidence_id": "e30",
      "quote": "此后，部队经宁夏兴隆镇、单家集一带转向隆德，于8月中旬攻克隆德县城。"
    },
    {
      "evidence_id": "e31",
      "quote": "该段路线的主要节点为两当、天水、秦安、静宁和隆德，新阳镇、千户镇、兴隆镇与单家集属于路线之间的重要中间地点。"
    },
    {
      "evidence_id": "e32",
      "quote": "红二十五军离开隆德后翻越六盘山，继续向平凉方向前进。"
    },
    {
      "evidence_id": "e33",
      "quote": "部队进入平凉地区后，在敌军围追堵截下不断调整行军路线，随后向泾川方向推进。"
    },
    {
      "evidence_id": "e34",
      "quote": "1935年8月21日，红二十五军在泾川四坡村一带与国民党军展开激烈战斗。"
    },
    {
      "evidence_id": "e35",
      "quote": "战斗结束后，部队继续向陇东方向转移，经平凉东部、镇原和庆阳一带向合水前进。"
    },
    {
      "evidence_id": "e36",
      "quote": "9月初，红二十五军到达合水县板桥镇，在这里进行短暂休整并与追击部队发生战斗。"
    },
    {
      "evidence_id": "e37",
      "quote": "该段路线的主要节点为隆德、平凉、泾川和板桥镇，镇原、庆阳为泾川至板桥镇之间的重要经过地区。"
    },
    {
      "evidence_id": "e38",
      "quote": "红二十五军离开板桥镇后，继续向东北方向行军。"
    },
    {
      "evidence_id": "e39",
      "quote": "部队经合水城关、张举塬和蒿咀铺等地前进，随后进入人烟稀少、道路崎岖的子午岭山区。"
    },
    {
      "evidence_id": "e40",
      "quote": "红军穿越子午岭后，经大凤川、东华池进入华池县豹子川，并于1935年9月7日在豹子川进行休整和部署。"
    },
    {
      "evidence_id": "e41",
      "quote": "此后，部队继续向陕北前进，于9月上旬到达永宁山，与陕甘革命根据地的党组织取得联系。"
    },
    {
      "evidence_id": "e42",
      "quote": "随后红二十五军由永宁山向延川方向行军，于9月15日到达永坪镇，次日与陕甘红军胜利会师。"
    },
    {
      "evidence_id": "e43",
      "quote": "该段路线的主要节点为板桥镇、豹子川和永坪镇，合水城关、子午岭、大凤川、东华池与永宁山属于这一段路线中的重要中间地点。"
    }
  ],
