  "evidence": [
    {
      "evidence_id": "e1",
      "quote": "1934年11月16日，红二十五军约2900人从河南省罗山县何家冲出发"
    },
    {
      "evidence_id": "e2",
      "quote": "向西进入桐柏山区"
    },
    {
      "evidence_id": "e3",
      "quote": "于11月26日在方城县独树镇七里岗地区进行独树镇战斗"
    },
    {
      "evidence_id": "e4",
      "quote": "随后绕经沈庄穿过许南公路，进入伏牛山区"
    },
    {
      "evidence_id": "e5",
      "quote": "经卢氏县叫河镇、大石河、文峪和卢氏县城南部的山地通道"
    },
    {
      "evidence_id": "e6",
      "quote": "于12月8日从豫陕交界的铁锁关进入陕西"
    },
    {
      "evidence_id": "e7",
      "quote": "部队继续经过三要司和九泉山，于12月9日至10日到达庾家河"
    },
    {
      "evidence_id": "e8",
      "quote": "何家冲为全程起点，使用红旗符号"
    },
    {
      "evidence_id": "e9",
      "quote": "独树镇和庾家河为重要战斗节点"
    },
    {
      "evidence_id": "e10",
      "quote": "第一段回旋从庾家河出发，向镇安、郧西、旬阳和山阳方向活动，随后北上柞水、蓝田葛牌镇和文公岭地区"
    },
    {
      "evidence_id": "e11",
      "quote": "其间重点标出蔡玉窑和文公岭战斗"
    },
    {
      "evidence_id": "e12",
      "quote": "红二十五军从郧西一带向西，经安康北部山区进入宁陕，随后攻占佛坪，进抵洋县华阳镇，并在石塔寺地区作战"
    },
    {
      "evidence_id": "e13",
      "quote": "之后从华阳、佛坪和宁陕地区向东返回"
    },
    {
      "evidence_id": "e14",
      "quote": "宁陕、佛坪和华阳是根据地扩展的重要节点"
    },
    {
      "evidence_id": "e15",
      "quote": "红二十五军从郧西二天门一带北上，经商县夜村、富水关，东进淅川荆紫关，随后折返山阳袁家沟口"
    },
    {
      "evidence_id": "e16",
      "quote": "袁家沟口战斗后，部队北出终南山，前锋到达西安以南的韦曲和子午镇，最后集中到沣峪口"
    },
    {
      "evidence_id": "e17",
      "quote": "袁家沟口为重要战斗节点"
    },
    {
      "evidence_id": "e18",
      "quote": "沣峪口为再次西征的阶段起点"
    },
    {
      "evidence_id": "e19",
      "quote": "1935年7月16日，红二十五军从沣峪口出发，先向南折入秦岭山区，作出佯攻汉中的行动，然后转向西北"
    },
    {
      "evidence_id": "e20",
      "quote": "部队随后进入甘肃，经两当到达天水，攻入天水北关"
    },
    {
      "evidence_id": "e21",
      "quote": "撤出天水后，经川口、天靖山、廖家岘和韩家湾，强渡渭河"
    },
    {
      "evidence_id": "e22",
      "quote": "继续经过秦安、静宁、兴隆镇、单家集和隆德，翻越六盘山后到达白水镇"
    },
    {
      "evidence_id": "e23",
      "quote": "1935年8月21日，部队在泾川县四坡村发生战斗，军政委吴焕先在此牺牲"
    },
    {
      "evidence_id": "e24",
      "quote": "此后红二十五军继续北上，经合水县豹子川进入陕西保安县永宁山"
    },
    {
      "evidence_id": "e25",
      "quote": "最后于9月15日到达延川县永坪镇，并于9月16日与红二十六军、红二十七军会师"
    },
    {
      "evidence_id": "e26",
      "quote": "永坪为全程终点和会师节点，使用会师符号"
    },
    {
      "evidence_id": "e27",
      "quote": "汉中只表示佯动方向，不作为攻占节点"
    },
    {
      "evidence_id": "e28",
      "quote": "何家冲—桐柏山区—独树镇七里岗—沈庄—伏牛山区—叫河镇—大石河—文峪—卢氏城南—铁锁关—三要司—九泉山—庾家河"
    },
    {
      "evidence_id": "e29",
      "quote": "庾家河—镇安—郧西—旬阳—山阳—柞水—蓝田葛牌镇—文公岭"
    },
    {
      "evidence_id": "e30",
      "quote": "郧西—安康北部山区—宁陕—佛坪—洋县华阳—石塔寺—佛坪—宁陕东返"
    },
    {
      "evidence_id": "e31",
      "quote": "郧西二天门—商县夜村—富水关—淅川荆紫关—山阳袁家沟口—终南山—韦曲—子午镇—沣峪口"
    },
    {
      "evidence_id": "e32",
      "quote": "沣峪口—秦岭佯动区—两当—天水北关—川口—天靖山—廖家岘—韩家湾—秦安—静宁—兴隆镇—单家集—隆德—六盘山—白水镇—泾川四坡村—合水豹子川—保安永宁山—延川永坪"
    }
  ],
