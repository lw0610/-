          "acquire_population"
        ],
        "instructions": "检查面几何、名称字段与统计表地区键，识别宽表/长表及真实列名，仅选取 2020 年常住人口总量单一指标；按地区名称精确关联，记录重复键、非法数值、未匹配与缺测清单；有效值足以分级时保留空值继续，空值表示缺测。",
        "outputs": [
          {
            "label": "河南省人口专题面图层",
            "type": "layers",
            "required": false
          }
        ]
