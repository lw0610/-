        "kind": "step",
        "capabilities": [
          "cartography-styling"
        ],
        "uses": [
          "hn_city_boundary"
        ],
        "depends_on": [
          "join_population"
        ],
        "instructions": "使用自然断点五级有序渐变渲染常住人口字段，核对数值字段、每级上下界与颜色；单一不同值或非数值字段时停止，不以统一填色冒充分级。",
        "outputs": [
          {
            "label": "分级设色专题图层",
            "type": "layers",
            "required": false
          }
        ]
      },
      {
        "id": "compose_layout",
        "title": "统计专题版面编排",
        "kind": "step",
        "capabilities": [
          "print-layout"
        ],
        "uses": [
          "hn_city_boundary"
        ],
        "depends_on": [
          "style_choropleth"
        ],
        "instructions": "使用「统计专题版式」（A4 横向），主图仅显示专题层与灰底层，标题、图例（写指标和单位）、比例尺、指北针、来源说明齐全；有灰底时说明缺测/未匹配/排除数量。",
        "outputs": [
          {
            "label": "统计专题版面",
            "type": "layout",
            "required": false
          }
        ]
      },
